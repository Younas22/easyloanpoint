{
  "info": {
    "name": "EasyLoanPoint — Flutter Auth API",
    "description": "Authentication APIs for EasyLoanPoint Flutter mobile app. Base URL: {{base_url}}/api/v1",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url",    "value": "http://127.0.0.1:8000",  "type": "string" },
    { "key": "auth_token",  "value": "",                        "type": "string" }
  ],
  "item": [
    {
      "name": "0. Health Check",
      "request": {
        "method": "GET",
        "url": { "raw": "{{base_url}}/api/v1/ping", "host": ["{{base_url}}"], "path": ["api","v1","ping"] },
        "header": [{ "key": "Accept", "value": "application/json" }]
      }
    },
    {
      "name": "1. Register",
      "event": [{
        "listen": "test",
        "script": { "exec": [
          "var json = pm.response.json();",
          "console.log('Register response:', JSON.stringify(json));"
        ], "type": "text/javascript" }
      }],
      "request": {
        "method": "POST",
        "url": { "raw": "{{base_url}}/api/v1/auth/register", "host": ["{{base_url}}"], "path": ["api","v1","auth","register"] },
        "header": [
          { "key": "Accept",       "value": "application/json" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Rahul Sharma\",\n  \"mobile\": \"9876543210\",\n  \"email\": \"rahul@example.com\",\n  \"password\": \"password123\",\n  \"password_confirmation\": \"password123\"\n}"
        }
      }
    },
    {
      "name": "2. Verify OTP (Registration)",
      "event": [{
        "listen": "test",
        "script": { "exec": [
          "var json = pm.response.json();",
          "if (json.status && json.data && json.data.token) {",
          "  pm.collectionVariables.set('auth_token', json.data.token);",
          "  console.log('Token saved:', json.data.token);",
          "}"
        ], "type": "text/javascript" }
      }],
      "request": {
        "method": "POST",
        "url": { "raw": "{{base_url}}/api/v1/auth/verify-otp", "host": ["{{base_url}}"], "path": ["api","v1","auth","verify-otp"] },
        "header": [
          { "key": "Accept",       "value": "application/json" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"mobile\": \"9876543210\",\n  \"otp\": \"123456\"\n}"
        }
      }
    },
    {
      "name": "3. Login",
      "event": [{
        "listen": "test",
        "script": { "exec": [
          "var json = pm.response.json();",
          "if (json.status && json.data && json.data.token) {",
          "  pm.collectionVariables.set('auth_token', json.data.token);",
          "  console.log('Token saved:', json.data.token);",
          "}"
        ], "type": "text/javascript" }
      }],
      "request": {
        "method": "POST",
        "url": { "raw": "{{base_url}}/api/v1/auth/login", "host": ["{{base_url}}"], "path": ["api","v1","auth","login"] },
        "header": [
          { "key": "Accept",       "value": "application/json" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"mobile\": \"9876543210\",\n  \"password\": \"password123\"\n}"
        }
      }
    },
    {
      "name": "4. Logout",
      "request": {
        "method": "POST",
        "url": { "raw": "{{base_url}}/api/v1/auth/logout", "host": ["{{base_url}}"], "path": ["api","v1","auth","logout"] },
        "header": [
          { "key": "Accept",        "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{auth_token}}" }
        ]
      }
    },
    {
      "name": "5. Forgot Password (Send OTP)",
      "request": {
        "method": "POST",
        "url": { "raw": "{{base_url}}/api/v1/auth/forgot-password", "host": ["{{base_url}}"], "path": ["api","v1","auth","forgot-password"] },
        "header": [
          { "key": "Accept",       "value": "application/json" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"mobile\": \"9876543210\"\n}"
        }
      }
    },
    {
      "name": "6. Reset Password",
      "request": {
        "method": "POST",
        "url": { "raw": "{{base_url}}/api/v1/auth/reset-password", "host": ["{{base_url}}"], "path": ["api","v1","auth","reset-password"] },
        "header": [
          { "key": "Accept",       "value": "application/json" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"mobile\": \"9876543210\",\n  \"otp\": \"654321\",\n  \"password\": \"newpassword123\",\n  \"password_confirmation\": \"newpassword123\"\n}"
        }
      }
    },
    {
      "name": "7. Resend OTP",
      "request": {
        "method": "POST",
        "url": { "raw": "{{base_url}}/api/v1/auth/resend-otp", "host": ["{{base_url}}"], "path": ["api","v1","auth","resend-otp"] },
        "header": [
          { "key": "Accept",       "value": "application/json" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"mobile\": \"9876543210\",\n  \"purpose\": \"register\"\n}"
        }
      }
    },
    {
      "name": "8. Get Authenticated User",
      "request": {
        "method": "GET",
        "url": { "raw": "{{base_url}}/api/v1/user", "host": ["{{base_url}}"], "path": ["api","v1","user"] },
        "header": [
          { "key": "Accept",        "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{auth_token}}" }
        ]
      }
    }
  ]
}
