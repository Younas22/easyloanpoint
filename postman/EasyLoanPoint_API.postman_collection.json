{
  "info": {
    "_postman_id": "a1b2c3d4-e5f6-7890-abcd-ef1234567890",
    "name": "EasyLoanPoint API",
    "description": "Complete Flutter API collection for EasyLoanPoint — generated from routes/api.php and all Api controllers. API prefix: api/v1 (set in bootstrap/app.php).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Ping",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/ping",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "ping"]
            },
            "description": "Public health-check. Returns API version and running status."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Rahul Sharma\",\n  \"mobile\": \"9876543210\",\n  \"email\": \"rahul@example.com\",\n  \"password\": \"Password@123\",\n  \"password_confirmation\": \"Password@123\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/api/v1/auth/register",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "auth", "register"]
            },
            "description": "Register a new customer. Sends OTP to mobile number on success.\n\nValidation:\n- name: required, string, min:2, max:100\n- mobile: required, 10-digit Indian mobile (6-9 start), unique\n- email: optional, valid email, unique\n- password: required, min:8, must match password_confirmation"
          },
          "response": []
        },
        {
          "name": "Verify OTP",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"mobile\": \"9876543210\",\n  \"otp\": \"123456\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/api/v1/auth/verify-otp",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "auth", "verify-otp"]
            },
            "description": "Verify the 6-digit OTP sent after registration. Returns Bearer token on success.\n\nValidation:\n- mobile: required, valid Indian mobile\n- otp: required, exactly 6 digits"
          },
          "response": []
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"mobile\": \"9876543210\",\n  \"password\": \"Password@123\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/api/v1/auth/login",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "auth", "login"]
            },
            "description": "Login with mobile + password. Revokes all previous tokens and issues a fresh Bearer token.\n\nValidation:\n- mobile: required, valid Indian mobile\n- password: required, string"
          },
          "response": []
        },
        {
          "name": "Forgot Password (Send OTP)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"mobile\": \"9876543210\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/api/v1/auth/forgot-password",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "auth", "forgot-password"]
            },
            "description": "Send OTP to registered mobile for password reset. Always returns success to prevent phone enumeration.\n\nValidation:\n- mobile: required, valid Indian mobile"
          },
          "response": []
        },
        {
          "name": "Reset Password",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"mobile\": \"9876543210\",\n  \"otp\": \"123456\",\n  \"password\": \"NewPassword@123\",\n  \"password_confirmation\": \"NewPassword@123\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/api/v1/auth/reset-password",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "auth", "reset-password"]
            },
            "description": "Verify OTP and set a new password. Revokes all active tokens — user must login again.\n\nValidation:\n- mobile: required, valid Indian mobile\n- otp: required, exactly 6 digits\n- password: required, min:8, must match password_confirmation"
          },
          "response": []
        },
        {
          "name": "Resend OTP",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"mobile\": \"9876543210\",\n  \"purpose\": \"register\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/api/v1/auth/resend-otp",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "auth", "resend-otp"]
            },
            "description": "Resend OTP for registration or forgot-password flow.\n\nValidation:\n- mobile: required, valid Indian mobile\n- purpose: required, one of: register | forgot_password"
          },
          "response": []
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Accept", "value": "application/json" }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/auth/logout",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "auth", "logout"]
            },
            "description": "Revoke the current Sanctum access token (logout). Requires Bearer token."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Loan Types",
      "item": [
        {
          "name": "Get Active Loan Types",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/loan-types",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "loan-types"]
            },
            "description": "Public endpoint — no auth required. Returns all active loan types configured by admin.\n\nResponse: data.loan_types[]\n- id, name, description, amount, repayment_days\n\nOnly types with status=active are returned, ordered by sort_order then id.\n\nAuto-apply: when a customer completes their profile (KYC + all required fields), the system automatically creates a pending loan application for the first active loan type."
          },
          "response": []
        }
      ]
    },
    {
      "name": "User",
      "item": [
        {
          "name": "Get Authenticated User",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Accept", "value": "application/json" }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/user",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "user"]
            },
            "description": "Returns basic info of the currently authenticated user: id, name, mobile, email, phone_verified, member_since."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Profile",
      "item": [
        {
          "name": "Get Profile",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Accept", "value": "application/json" }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/customer/profile",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "customer", "profile"]
            },
            "description": "Returns authenticated user's profile, KYC details, and bank accounts. kyc is null if KYC not yet submitted. bank_accounts is an empty array if none added."
          },
          "response": []
        },
        {
          "name": "Update Profile",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Accept", "value": "application/json" }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "name",             "value": "Rahul Sharma",        "type": "text", "description": "optional — min:2, max:100" },
                { "key": "email",            "value": "rahul@example.com",   "type": "text", "description": "optional — valid email, unique" },
                { "key": "profile_image",    "type": "file", "src": [],      "description": "optional — jpg/jpeg/png, max 2MB" },
                { "key": "aadhaar_number",   "value": "123456789012",        "type": "text", "description": "optional — exactly 12 digits" },
                { "key": "aadhaar_document", "type": "file", "src": [],      "description": "optional — jpg/jpeg/png/pdf, max 5MB" },
                { "key": "pan_number",       "value": "ABCDE1234F",          "type": "text", "description": "optional — format: ABCDE1234F" },
                { "key": "pan_document",     "type": "file", "src": [],      "description": "optional — jpg/jpeg/png/pdf, max 5MB" },
                { "key": "selfie_document",  "type": "file", "src": [],      "description": "optional — jpg/jpeg/png, max 2MB" },
                { "key": "address",          "value": "123, MG Road, Pune",  "type": "text", "description": "optional — max:500" },
                { "key": "city",             "value": "Pune",                "type": "text", "description": "optional — max:100" },
                { "key": "state",            "value": "Maharashtra",         "type": "text", "description": "optional — max:100" },
                { "key": "pincode",          "value": "411001",              "type": "text", "description": "optional — exactly 6 digits" },
                { "key": "dob",              "value": "1995-06-15",          "type": "text", "description": "optional — YYYY-MM-DD, before today" },
                { "key": "gender",           "value": "male",                "type": "text", "description": "optional — male | female | other" },
                { "key": "employment_type",  "value": "salaried",            "type": "text", "description": "optional — salaried | self_employed | business | unemployed" },
                { "key": "salary",           "value": "50000",               "type": "text", "description": "optional — numeric, min:0" },
                { "key": "bank1_name",           "value": "HDFC Bank",       "type": "text", "description": "optional — primary bank name, max:100" },
                { "key": "bank1_account_number", "value": "1234567890",      "type": "text", "description": "optional — 6–20 digits" },
                { "key": "bank1_ifsc_code",      "value": "HDFC0001234",     "type": "text", "description": "optional — format: ABCD0123456 (11 chars)" },
                { "key": "bank1_holder_name",    "value": "Rahul Sharma",    "type": "text", "description": "optional — name as per bank, max:100" },
                { "key": "bank2_name",           "value": "SBI",             "type": "text", "description": "optional — second bank name (max 2 accounts)" },
                { "key": "bank2_account_number", "value": "9876543210",      "type": "text", "description": "optional — 6–20 digits" },
                { "key": "bank2_ifsc_code",      "value": "SBIN0001234",     "type": "text", "description": "optional — format: ABCD0123456 (11 chars)" },
                { "key": "bank2_holder_name",    "value": "Rahul Sharma",    "type": "text", "description": "optional — name as per bank, max:100" }
              ]
            },
            "url": {
              "raw": "{{base_url}}/api/v1/customer/profile",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "customer", "profile"]
            },
            "description": "Update customer profile, KYC details, documents, and bank accounts in a single request.\n\nMethod: PUT — Content-Type: multipart/form-data\n\nIMPORTANT: Do NOT manually add Content-Type in the Headers tab. Postman sets it automatically when body type is form-data.\n\nAll fields are optional — send only what needs to be updated.\n\nUser fields:\n- name, email, profile_image\n\nKYC text fields:\n- aadhaar_number, pan_number, address, city, state, pincode, dob, gender, employment_type, salary\n\nKYC documents (files):\n- aadhaar_document: Aadhaar card image/PDF\n- pan_document: PAN card image/PDF\n- selfie_document: Live selfie photo\n\nBank accounts (max 2 per customer):\n- bank1_name, bank1_account_number, bank1_ifsc_code, bank1_holder_name (primary)\n- bank2_name, bank2_account_number, bank2_ifsc_code, bank2_holder_name (optional)\n- IFSC format: 4 letters + 0 + 6 alphanumeric (e.g. HDFC0001234)\n- Account number: 6–20 digits\n- Response includes bank_accounts[] array with masked account numbers\n\nDocuments stored at: public/uploads/kyc/{user_id}/{type}/"
          },
          "response": []
        }
      ]
    },
    {
      "name": "Loans",
      "item": [
        {
          "name": "Apply for Loan",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"loan_type\": \"personal\",\n  \"amount_requested\": 150000,\n  \"tenure_months\": 24,\n  \"purpose\": \"Medical expenses for family treatment\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/api/v1/customer/loans/apply",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "customer", "loans", "apply"]
            },
            "description": "Submit a new loan application. Customer profile (KYC) must be complete and active before applying.\n\nValidation:\n- loan_type: required, one of: personal | home | business | vehicle | education\n- amount_requested: required, numeric, min:1000, max:10000000\n- tenure_months: required, integer, min:1, max:360\n- purpose: required, string, max:500"
          },
          "response": []
        },
        {
          "name": "Loan History",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Accept", "value": "application/json" }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/customer/loans",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "customer", "loans"],
              "query": [
                { "key": "status", "value": "pending", "description": "optional filter: pending | under_review | approved | rejected | disbursed | closed", "disabled": true },
                { "key": "loan_type", "value": "personal", "description": "optional filter: personal | home | business | vehicle | education", "disabled": true },
                { "key": "per_page", "value": "10", "description": "optional, default 10, max 50", "disabled": true }
              ]
            },
            "description": "Paginated list of customer's loan applications, ordered by applied_at desc. Includes document list per loan."
          },
          "response": []
        },
        {
          "name": "Loan Status Tracking",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Accept", "value": "application/json" }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/customer/loans/1/status",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "customer", "loans", "1", "status"]
            },
            "description": "Full status tracking for a single loan. Returns loan details, status change timeline, and all uploaded documents with their review status.\n\nURL param: loanId (integer)"
          },
          "response": []
        }
      ]
    },
    {
      "name": "Loan Documents",
      "item": [
        {
          "name": "Upload Loan Document (Aadhaar / PAN / Selfie)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Accept", "value": "application/json" }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "description": "required — jpg/jpeg/png/pdf, max 5MB",
                  "src": []
                }
              ]
            },
            "url": {
              "raw": "{{base_url}}/api/v1/customer/loans/:loanId/documents/:type",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "customer", "loans", ":loanId", "documents", ":type"],
              "variable": [
                { "key": "loanId", "value": "1", "description": "Loan ID" },
                { "key": "type",   "value": "aadhaar", "description": "aadhaar | pan | selfie" }
              ]
            },
            "description": "Upload a document for a specific loan application.\n\nNote: These are LOAN-level documents (per loan application). KYC identity documents (aadhaar_document, pan_document, selfie_document) are uploaded via PUT /customer/profile.\n\nURL params:\n- loanId: integer\n- type: aadhaar | pan | selfie\n\nBody (form-data):\n- file: required, jpg/jpeg/png/pdf, max 5MB"
          },
          "response": []
        }
      ]
    },
    {
      "name": "Notifications",
      "item": [
        {
          "name": "List Notifications",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Accept", "value": "application/json" }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/customer/notifications",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "customer", "notifications"]
            },
            "description": "Paginated list of notifications for the authenticated user (20 per page, latest first). Also returns current unread_count."
          },
          "response": []
        },
        {
          "name": "Unread Count",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Accept", "value": "application/json" }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/customer/notifications/unread-count",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "customer", "notifications", "unread-count"]
            },
            "description": "Returns the total count of unread notifications for the authenticated user."
          },
          "response": []
        },
        {
          "name": "Mark All Notifications Read",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Accept", "value": "application/json" }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/customer/notifications/mark-all-read",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "customer", "notifications", "mark-all-read"]
            },
            "description": "Marks all unread notifications as read for the authenticated user."
          },
          "response": []
        },
        {
          "name": "Mark Single Notification Read",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Accept", "value": "application/json" }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/customer/notifications/1/read",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "customer", "notifications", "1", "read"]
            },
            "description": "Marks a single notification as read. Returns 404 if it does not belong to the authenticated user.\n\nURL param: id (integer)"
          },
          "response": []
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost/easyloanpoint/public",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    }
  ]
}
